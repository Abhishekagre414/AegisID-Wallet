# ---- Server ----
PORT=5000
NODE_ENV=development            # use "production" when deployed

# Public URL of the deployed app (used inside credentialStatus / status list URLs)
APP_URL=http://localhost:5000

# ---- Issuer security ----
# Protects issuing, revoking and listing issued credentials (sent as the x-api-key header).
# REQUIRED in production (>= 24 chars): the server refuses to start without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ISSUER_API_KEY=
# Optional: one key per operator, recorded in the audit log (GET /api/audit). Format: name:key,name:key
ISSUER_API_KEYS=

# REQUIRED in production (>= 32 chars): derive all issuer signing keys from this secret (HKDF) so that
# no private key is ever written to disk and issuers survive redeploys / ephemeral hosts.
# Changing it changes the issuer DIDs, so previously issued credentials will stop verifying.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ISSUER_MASTER_SECRET=

# ---- CORS ----
# Comma-separated list of browser origins allowed to call the API. Leave empty for same-origin
# only in production (the bundled frontend is served by the same server).
CORS_ORIGIN=

# ---- Storage ----
# Directory for the SQLite database (aegis.db). Point it at a PERSISTENT disk/volume in production.
DATA_DIR=
